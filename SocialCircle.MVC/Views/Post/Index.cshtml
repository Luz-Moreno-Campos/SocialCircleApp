@model IEnumerable<SocialCircle.Models.Post>

@{
    ViewData["Title"] = "Posts";
}

<h2>Posts</h2>

<form asp-controller="Post" asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search posts" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<p>
    <a asp-controller="Post" asp-action="Create" class="btn btn-primary">Create New Post</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Author</th>
            <th>Content</th>
            <th>Posted On</th>
            <th>Comments</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <tr>
                    <td>@post.PostId</td>
                    <td>@(post.User?.UserName ?? "Unknown")</td>
                    <td>@post.TextContent</td>
                    <td>@post.PostTimeStamp.ToString("g")</td>
                    <td>@(post.Comments?.Count ?? 0)</td>
                    <td>
                        <a asp-controller="Post" asp-action="Details" asp-route-id="@post.PostId" class="btn btn-sm btn-info">Details</a>
        
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No posts found.</td>
            </tr>
        }
    </tbody>
</table>