@model SocialCircle.MVC.Models.Like

<h2>Add Like</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>User ID</label>
        <input asp-for="UserId" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Post ID</label>
        <input asp-for="PostId" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Save
    </button>

</form>