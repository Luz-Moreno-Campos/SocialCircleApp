@model SocialCircle.Models.ViewModels.UserViewModel

<div class="container mt-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center"
             style="width: 70px; height: 70px; font-size: 28px;">
            @Model.Initials
        </div>

        <div>
            <h2 class="mb-1">@Model.UserName</h2>
            <p class="text-muted mb-0">@Model.Bio</p>
        </div>
    </div>

    <div class="d-flex gap-4 mb-4">
       
        <a href="/Follow/Followers/@Model.UserId" class="text-decoration-none">
            <strong>@Model.FollowersCount</strong> followers
        </a>

        <a href="/Follow/Following/@Model.UserId" class="text-decoration-none">
            <strong>@Model.FollowingCount</strong> following
        </a>

        <span>
            <strong>@Model.PostCount</strong> posts
        </span>
    </div>

    <hr />

    @if (!Model.IsOwnProfile)
    {
        if (Model.IsFollowing)
        {
            <form method="post" action="/Follow/Unfollow">
                <input type="hidden" name="targetId" value="@Model.UserId" />
                <button class="btn btn-danger">Unfollow</button>
            </form>
        }
        else
        {
            <form method="post" action="/Follow/Follow">
                <input type="hidden" name="targetId" value="@Model.UserId" />
                <button class="btn btn-primary">Follow</button>
            </form>
        }
    }

    <h4 class="mb-3">Posts</h4>

    @if (Model.Posts != null && Model.Posts.Any())
    {
        foreach (var post in Model.Posts)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <p>@post.TextContent</p>
                    <small class="text-muted">@post.PostTimeStamp</small>

                    @if (post.Comments != null && post.Comments.Any())
                    {
                        <div class="mt-3 ps-3 border-start">
                            <h6>Comments (@post.Comments.Count)</h6>

                            @foreach (var comment in post.Comments)
                            {
                                <div class="mb-2">
                                    <p>@comment.CommentText</p>
                                    <small class="text-muted">@comment.CommentTimeStamp.ToString("g")</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mt-2">No comments yet.</p>
                    }
                </div>
            </div>

        }
    }
    else
    {
        <p class="text-muted">This user has no posts yet.</p>
    }

</div>
