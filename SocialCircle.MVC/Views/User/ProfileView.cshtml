@model SocialCircle.Models.ViewModels.UserViewModel

<div class="container mt-4">

    <!-- Header del usuario -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center"
             style="width: 70px; height: 70px; font-size: 28px;">
            @Model.Initials
        </div>

        <div>
            <h2 class="mb-1">@Model.UserName</h2>
            <p class="text-muted mb-0">@Model.Bio</p>
        </div>
    </div>

    <!-- Contadores -->
    <div class="d-flex gap-4 mb-4">

        <a href="/User/Followers/@Model.UserId" class="text-decoration-none">
            <strong>@Model.FollowersCount</strong> followers
        </a>

        <a href="/User/Following/@Model.UserId" class="text-decoration-none">
            <strong>@Model.FollowingCount</strong> following
        </a>

        <span>
            <strong>@Model.PostCount</strong> posts
        </span>
    </div>

    <hr />

    <!-- Posts -->
    <h4 class="mb-3">Posts</h4>

    @if (Model.Posts != null && Model.Posts.Any())
    {
        foreach (var post in Model.Posts)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <p>@post.Content</p>
                    <small class="text-muted">@post.PostTimeStamp</small>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted">This user has no posts yet.</p>
    }

</div>
