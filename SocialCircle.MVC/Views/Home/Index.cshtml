<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        $('.ajax-comment-form').on('submit', function(e) {
            e.preventDefault();

            var form = $(this);
            var postId = form.data('post-id');
            var inputField = form.find('.comment-input');
            var text = inputField.val();

            $.ajax({
                url: '@Url.Action("AddComment", "Post")',
                type: 'POST',
                data: form.serialize(),
                success: function(response) {
                    var container = $('#comment-list-' + postId);
                    container.find('.no-comments-msg').remove();

                    var currentTime = new Date().toLocaleString([], { dateStyle: 'short', timeStyle: 'short' });
                    var newCommentHtml =
                        '<div class="comment-item mb-2 pb-2 border-bottom">' +
                        '<span class="fw-bold text-dark small">You</span>' +
                        '<span class="small ms-1">' + text + '</span>' +
                        '<div class="text-muted extra-small" style="font-size: 0.75rem;">' + currentTime + '</div>' +
                        '</div>';

                    container.append(newCommentHtml);
                    inputField.val('');
                },
                error: function() {
                    alert('Error posting comment.');
                }
            });
        });
    });
</script>
