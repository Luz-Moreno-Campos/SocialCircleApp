@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex flex-column justify-content-center align-items-center" style="height: 80vh;">
    <h2 class="display-1 fw-bold">Welcome to Social Circle</h2>
    <h2 class="lead mb-4"> Build your circle, grow your story.</h2>

    <div class="d-flex gap-3">
        <a asp-controller="User" asp-action="Login" class="btn btn-primary btn-lg">Login</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">Sign Up</a>
    </div>
</div>

