@model IEnumerable<SocialCircle.Models.Post>

@{
    ViewData["Title"] = "Home Page";
}

@if (Model == null)
{
    <div class="d-flex flex-column justify-content-center align-items-center" style="height: 80vh;">
        <h2 class="display-1 fw-bold">Welcome to Social Circle</h2>
        <h2 class="lead mb-4">Build your circle, grow your story.</h2>

        <div class="d-flex gap-3">
            <a asp-controller="User" asp-action="Login" class="btn btn-primary btn-lg">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">Sign Up</a>
        </div>
    </div>
}
else
{
    <h2 class="mb-4">Posts from your Circle</h2>

    @foreach (var post in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <a asp-controller="User"
                       asp-action="Profile"
                       asp-route-id="@post.UserId"
                       class="fw-bold text-primary text-decoration-none fs-5">
                        @@(post.User != null ? post.User.UserName : $"User #{post.UserId}")
                    </a>
                    <small class="text-muted">@post.PostTimeStamp.ToString("g")</small>
                </div>

                <p class="fs-6 mt-2">@post.TextContent</p>

                <hr />

                <div class="comments-section bg-light p-3 rounded">
                    <h6 class="fw-bold mb-3">
                        Comments (@(post.Comments?.Count ?? 0))
                    </h6>

                    @if (post.Comments != null && post.Comments.Any())
                    {
                        @foreach (var comment in post.Comments)
                        {
                            <div class="comment-item mb-2 pb-2 border-bottom">
                                <a asp-controller="User"
                                   asp-action="Profile"
                                   asp-route-id="@comment.UserId"
                                   class="fw-bold text-decoration-none text-dark small">
                                    @@(comment.User != null ? comment.User.UserName : $"User #{comment.UserId}")
                                </a>

                                <span class="small ms-1">@comment.CommentText</span>

                                <div class="text-muted extra-small" style="font-size: 0.75rem;">
                                    @comment.CommentTimeStamp.ToString("g")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-3">No comments yet.</p>
                    }

                    <form asp-controller="Post" asp-action="AddComment" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@post.PostId" />
                        <input type="hidden" name="userId" value="@(Context.Session.GetInt32("UserId") ?? 1)" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <div class="input-group input-group-sm">
                            <input type="text" name="text" class="form-control" placeholder="Write a comment..." required />
                            <button type="submit" class="btn btn-primary">Comment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}