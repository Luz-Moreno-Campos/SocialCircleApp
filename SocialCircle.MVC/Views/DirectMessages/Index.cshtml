@model List<SocialCircle.MVC.Models.DirectMessage>

<h2>Direct Messages</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Send Message</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Message ID</th>
            <th>Sender</th>
            <th>Receiver</th>
            <th>Message</th>
            <th>Sent At</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MessageId</td>
                <td>@item.SenderId</td>
                <td>@item.ReceiverId</td>
                <td>@item.MessageText</td>
                <td>@item.SentAt</td>
            </tr>
        }
    </tbody>
</table>